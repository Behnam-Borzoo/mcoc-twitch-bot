# نام اکانت توییچی که Bot باهاش لاگین می‌کنه (می‌تونه اکانت خودت یا یه اکانت جدا باشه)
TWITCH_BOT_USERNAME=your_bot_username

# OAuth Token — از این آدرس بگیر: https://twitchapps.com/tmi/
# باید با oauth: شروع بشه
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxx

# نام کانالی که Bot توش فعالیت می‌کنه (بدون #)
TWITCH_CHANNEL=BehnamBorzoo

# لینک دیسکورد برای کامند !discord
DISCORD_LINK=https://discord.gg/your-invite

# Champion و Rank فعلی (اینا رو خودت هر وقت عوض شد آپدیت کن)
CURRENT_CHAMP=Shathra
CURRENT_RANK=Rank 5 Ascended

# API Key انتروپیک برای جواب دادن هوشمند به سؤالات چت — از https://console.anthropic.com بگیر
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# هر چند ثانیه یک نفر حداکثر می‌تونه از AI جواب بگیره (جلوگیری از اسپم و هزینه زیاد)
AI_COOLDOWN_SECONDS=20

# -------------------- برای Follow/Sub Alerts (فاز ۳) --------------------
# Client ID از https://dev.twitch.tv/console/apps بگیر (یه App جدید ثبت کن)
TWITCH_CLIENT_ID=your_client_id_here

# Access Token با اسکوپ‌های moderator:read:followers و channel:read:subscriptions
TWITCH_ACCESS_TOKEN=your_access_token_here

# برای Refresh خودکار توکن — پایین توضیح دادم چطور بگیریشون
TWITCH_CLIENT_SECRET=your_client_secret_here
TWITCH_REFRESH_TOKEN=your_refresh_token_here

# -------------------- برای سیستم رأی‌گیری (فاز ۴) --------------------
# مدت‌زمان پیش‌فرض هر رأی‌گیری به ثانیه (پیش‌فرض ۶۰ ثانیه)
POLL_DURATION_SECONDS=60

# -------------------- برای Loyalty Points --------------------
# هر کاربر فعال هر چند دقیقه یک‌بار چند امتیاز می‌گیره
POINTS_PER_INTERVAL=10
POINTS_INTERVAL_MINUTES=10

# -------------------- یادآوری فالو/حمایت --------------------
# هر چند دقیقه یک‌بار پیام یادآوری فالو (چرخشی بین EN/FA/DE) فرستاده بشه
FOLLOW_REMINDER_INTERVAL_MINUTES=20
