# نام اکانت توییچی که Bot باهاش لاگین می‌کنه (می‌تونه اکانت خودت یا یه اکانت جدا باشه)
TWITCH_BOT_USERNAME=your_bot_username

# OAuth Token — از این آدرس بگیر: https://twitchapps.com/tmi/
# باید با oauth: شروع بشه
TWITCH_OAUTH_TOKEN=oauth:xxxxxxxxxxxxxxxx

# نام کانالی که Bot توش فعالیت می‌کنه (بدون #)
TWITCH_CHANNEL=MaxMustermann

# لینک دیسکورد برای کامند !discord
DISCORD_LINK=https://discord.gg/your-invite

# Champion و Rank فعلی (اینا رو خودت هر وقت عوض شد آپدیت کن)
CURRENT_CHAMP=Shathra
CURRENT_RANK=Rank 5 Ascended

# API Key انتروپیک برای جواب دادن هوشمند به سؤالات چت — از https://console.anthropic.com بگیر
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# هر چند ثانیه یک نفر حداکثر می‌تونه از AI جواب بگیره (جلوگیری از اسپم و هزینه زیاد)
AI_COOLDOWN_SECONDS=20
